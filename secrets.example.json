{
  "providerAssembly": "./src/Neko.Transport/bin/Release/net10.0-windows/Neko.Transport.dll",
  "providerFactory": "Neko.Transport.Factory",
  "providerSettings": "./secrets.json",
  "creationScope": "",
  "accessToken": "",
  "stateDirectory": "./state",
  "port": 8767,
  "transport": {
    "profileDirectory": "./local-session-profile",
    "siteOrigin": "https://service.example.org",
    "apiPrefix": "/service/",
    "assetPrefix": "/assets/",
    "projectListingPath": "/service/groups/{scope}/conversations?cursor={cursor}",
    "conversationHistoryPath": "/service/conversations/{id}",
    "streamStatusPath": "/service/conversation/{id}/stream_status",
    "submitPath": "/service/conversation",
    "scopePattern": "^group-[a-z0-9-]+$",
    "composerSelector": "form[data-composer]",
    "submitExportName": "submitCompletion",
    "modelMarker": "global-selection",
    "modelCacheKey": "available-models",
    "fallbackMetadataKey": "rich-content",
    "submitModuleFallbacks": [],
    "modelModuleFallback": "",
    "catalogModuleFallback": "",
    "parentField": "parent_id",
    "scopeField": "group_id",
    "conversationField": "conversation_id",
    "forwardHeaders": ["authorization"]
  }
}
