<Window x:Class="Neko.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:browser="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Neko" Width="1360" Height="900"
        MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded">
    <DockPanel Background="#0c1116">
        <Border DockPanel.Dock="Top" Background="#203b34" Padding="12,6">
            <TextBlock Foreground="#c4f0e1" FontSize="13" Text="Offline shell preview • no account or network provider connected"/>
        </Border>
        <browser:WebView2 x:Name="Browser" DefaultBackgroundColor="#0c1116"/>
    </DockPanel>
</Window>
