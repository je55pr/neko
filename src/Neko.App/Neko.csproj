<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Neko</AssemblyName>
    <RootNamespace>Neko</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Neko.Core\Neko.Core.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <InternalsVisibleTo Include="Neko.App.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="frontend\index.html" Link="wwwroot\index.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\ui\**\*.*" Link="wwwroot\scripts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
